{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleCam",
  "version": "0.3.0",
  "identifier": "com.simplecam.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SimpleCam",
        "width": 480,
        "height": 740,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "SimpleCam",
    "copyright": "Copyright (c) 2026 SimpleCam",
    "category": "Video",
    "shortDescription": "Ultra lightweight screen recorder",
    "longDescription": "SimpleCam is an ultra lightweight screen recorder for Windows. Record a full display or a single window from 144p up to 4K.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "French",
          "German",
          "Spanish",
          "Arabic",
          "Russian",
          "SimpChinese",
          "Turkish"
        ],
        "startMenuFolder": "SimpleCam",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "licenseFile": "../LICENSE"
  }
}
