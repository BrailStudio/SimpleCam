{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleCam",
  "version": "1.0.0",
  "identifier": "com.simplecam.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SimpleCam",
        "width": 820,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
